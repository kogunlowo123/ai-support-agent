# Copy to .env and edit. Never commit .env — it is in .gitignore, and the
# secret-scanning workflow fails the build if a credential reaches a commit.
#
# Every value below is a default that already works. A clean clone with no .env
# at all starts, seeds itself and answers real questions, because the agent
# composes replies from tool results when no model is configured.
#
# Nested settings use a double underscore: AGENT_<SECTION>__<FIELD>.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# local | test | staging | production
# "production" enables invariants that refuse to start an unsafe process:
# authentication on, verification on, identity checks on, no message content in
# logs, no SQL echo, and a database that is not SQLite.
AGENT_ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite is the default and is fine for a single process. Production requires a
# durable multi-writer database; install the extra with `uv sync --extra postgres`.
AGENT_STORAGE__DATABASE_URL=sqlite+aiosqlite:///./var/agent.db
# AGENT_STORAGE__DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent
AGENT_STORAGE__ECHO_SQL=false
AGENT_STORAGE__POOL_SIZE=5

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Keys are comma-separated and written `tenant:secret` or
# `tenant:secret:scope|scope`. The tenant and scopes are properties of the
# credential, never of the request, so a caller cannot claim authority by asking.
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Known scopes: knowledge:read, account:read, order:read, ticket:write,
# refund:write, admin. A key with no scopes listed gets the customer-facing
# default set, which deliberately excludes refund:write — issuing money is a
# decision a person makes.
# Off here so a clean clone starts with no editing. This is a LOCAL value: any
# deployed instance must set it to true and supply at least one key, and a
# process with AGENT_ENVIRONMENT=production refuses to start without both.
# Requiring a key with none configured is also refused, because nobody could
# ever authenticate.
AGENT_SECURITY__REQUIRE_API_KEY=false
# AGENT_SECURITY__API_KEYS=acme:replace-with-a-generated-secret

# Tenant assigned to a caller when authentication is off, and the tenant the CLI
# seeds and evaluates against. They have to match, or a local instance serves an
# empty database while `support-agent seed` reports success.
AGENT_SECURITY__DEFAULT_TENANT=default
AGENT_SECURITY__MAX_REQUEST_BYTES=262144
AGENT_SECURITY__REDACT_PII_IN_LOGS=true

# What to do with instruction-like text found in a message or a tool result:
# annotate | neutralise | refuse. "neutralise" replaces the matched span with an
# explicit marker and keeps the surrounding facts usable.
AGENT_SECURITY__INJECTION_ACTION=neutralise
AGENT_SECURITY__INJECTION_REFUSE_THRESHOLD=0.85

# ---------------------------------------------------------------------------
# The model
# ---------------------------------------------------------------------------
# template | ollama | openai
#
# A model is used for exactly one thing: phrasing material that has already been
# decided. Classification, planning, policy and verification are deterministic,
# so "template" is a working default rather than a stub — the agent still
# classifies, gathers, decides, verifies and answers without one.
AGENT_CHAT__BACKEND=template
AGENT_CHAT__MODEL=llama3.2:3b
AGENT_CHAT__TEMPERATURE=0.0
AGENT_CHAT__MAX_OUTPUT_TOKENS=500
AGENT_CHAT__TIMEOUT_SECONDS=30

# Local models: no credentials, no per-token cost.
AGENT_PROVIDERS__OLLAMA_BASE_URL=http://127.0.0.1:11434

# Any OpenAI-compatible endpoint: Azure OpenAI, vLLM, LiteLLM, llama.cpp.
AGENT_PROVIDERS__OPENAI_BASE_URL=https://api.openai.com/v1
# AGENT_PROVIDERS__OPENAI_API_KEY=sk-replace-me

# ---------------------------------------------------------------------------
# Budgets — what makes the agent bounded rather than a loop
# ---------------------------------------------------------------------------
AGENT_LIMITS__MAX_STEPS=12
AGENT_LIMITS__MAX_TOOL_CALLS=6
AGENT_LIMITS__MAX_TOOL_CALLS_PER_TOOL=3
AGENT_LIMITS__MAX_RUN_SECONDS=30
AGENT_LIMITS__TOOL_TIMEOUT_SECONDS=5
AGENT_LIMITS__TOOL_MAX_RETRIES=2
AGENT_LIMITS__MAX_MESSAGE_CHARS=4000
AGENT_LIMITS__MAX_CONVERSATION_TURNS=40

# ---------------------------------------------------------------------------
# Circuit breakers
# ---------------------------------------------------------------------------
AGENT_CIRCUIT_BREAKER__FAILURE_THRESHOLD=4
AGENT_CIRCUIT_BREAKER__RESET_SECONDS=30
AGENT_CIRCUIT_BREAKER__HALF_OPEN_SUCCESSES=2

# ---------------------------------------------------------------------------
# Policy — computed in code, never by a model
# ---------------------------------------------------------------------------
AGENT_POLICY__REFUND_WINDOW_DAYS=30
AGENT_POLICY__DIGITAL_REFUND_WINDOW_DAYS=14
# Minor units: 50000 means 500.00. At or above this, a person approves.
AGENT_POLICY__REFUND_APPROVAL_THRESHOLD_MINOR_UNITS=50000
AGENT_POLICY__REQUIRE_IDENTITY_FOR_ACCOUNT_DATA=true
AGENT_POLICY__REQUIRE_IDENTITY_FOR_WRITES=true
# The agent never issues a refund itself. Enabling this is not supported by the
# threat model and production refuses to start unless writes require identity.
AGENT_POLICY__ALLOW_AGENT_INITIATED_REFUNDS=false

# ---------------------------------------------------------------------------
# Answer verification
# ---------------------------------------------------------------------------
# The control that turns "never invent account information" from a prompt
# instruction into an enforced property. Production refuses to start with it off.
AGENT_VERIFICATION__ENABLED=true
AGENT_VERIFICATION__MIN_SUPPORTED_RATIO=0.8
AGENT_VERIFICATION__FORBID_UNSUPPORTED_NUMBERS=true
# escalate | strip | refuse
AGENT_VERIFICATION__ON_FAILURE=escalate

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
AGENT_OBSERVABILITY__LOG_LEVEL=INFO
# json for aggregation, console for a readable terminal
AGENT_OBSERVABILITY__LOG_FORMAT=json
AGENT_OBSERVABILITY__SERVICE_NAME=support-agent
# Customer message text is user data. Off everywhere; production refuses to start
# with it on.
AGENT_OBSERVABILITY__LOG_MESSAGE_CONTENT=false
AGENT_OBSERVABILITY__TRACING_ENABLED=false
# AGENT_OBSERVABILITY__OTLP_ENDPOINT=http://localhost:4318
AGENT_OBSERVABILITY__TRACE_SAMPLE_RATIO=1.0
